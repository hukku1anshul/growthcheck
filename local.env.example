# Copy this file to `local.env` and fill in the values you have.
#
#   copy local.env.example local.env
#
# `local.env` is gitignored. This template is tracked and must never contain a
# real value. Nothing here is needed to BUILD or VIEW the site - the published
# app is static and holds no secrets. These are only for fetching new data.

# Google Fact Check Tools API, used by `python -m ingest.run factcheck`.
# Free key: https://console.cloud.google.com/apis/credentials
#   + CREATE CREDENTIALS -> API key   (NOT an OAuth client, NOT a service
#   account - this API authenticates with a plain ?key= parameter)
# Then restrict the key to the "Fact Check Tools API".
GOOGLE_FACTCHECK_KEY=

# Optional. An OCDS procurement endpoint for `python -m ingest.run ocds`.
# Left blank, the extractor uses its built-in default.
# OCDS_URL=
